digraph usb {
  graph [
    fontname="Microsoft YaHei",
    rankdir=TB,
    label="USB 握手与周期帧",
    labelloc=t,
    fontsize=16
  ];
  node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#f7f7f7"];
  edge [fontname="Microsoft YaHei"];

  f200 [label="STM32 → Jetson\n类型 16  载荷 01\n到达"];
  f190 [label="Jetson → STM32\n类型 5\n01 受理 / 00 当前阶段拒绝"];
  f191 [label="Jetson → STM32\n类型 6\nvalid、passed、destination"];
  f193 [label="Jetson → STM32\n类型 8\n01、destination、token 小端"];
  f203 [label="STM32 → Jetson\n类型 17\n01 + token"];
  f192a [label="Jetson → STM32\n类型 7\naccepted、command=1、token"];
  f204 [label="STM32 → Jetson\n类型 18\n01 + token\n安全区到达"];
  f192b [label="类型 7\ncommand=2"];
  f206 [label="STM32 → Jetson\n类型 20\n01 + token\n投送"];
  f192c [label="类型 7\ncommand=4"];
  f205 [label="STM32 → Jetson\n类型 19  载荷 01\n重找"];
  f192d [label="类型 7\ncommand=3，token 填 0"];
  periodic [label="周期帧（寻找或导航时）\n类型 1 心跳（alive=0 为失联）\n类型 3 目标中心\n类型 4 安全区中心", shape=note, fillcolor="#fff8e8"];

  f200 -> f190 -> f191 -> f193 -> f203 -> f192a -> f204 -> f192b -> f206 -> f192c -> f205 -> f192d;
  note [label="未授权的类型 17 仍回类型 7，accepted=0\n畸形帧和未知类型无回包", shape=note, fillcolor="#fff8e8"];
}
