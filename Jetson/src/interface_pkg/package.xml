<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>interface_pkg</name>
  <version>0.0.0</version>
  <description>Shared robot interfaces including segmentation and OpenCV field observations.</description>
  <maintainer email="li@todo.todo">li</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 构建时生成消息/服务类型；运行时消费者使用导出的类型支持和共享头。 -->
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_export_depend>rclcpp</build_export_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>


  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
