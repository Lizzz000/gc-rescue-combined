{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "STM32"
                }
            },
            "cacheVariables": {
                "INS_USE_MAGNETOMETER": "OFF"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Debug-9axis",
            "inherits": "Debug",
            "cacheVariables": {
                "INS_USE_MAGNETOMETER": "ON"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Debug-9axis",
            "configurePreset": "Debug-9axis"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}
